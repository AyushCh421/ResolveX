# Copy to .env and fill in. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/resolvex?retryWrites=true&w=majority

# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed to call this API. Comma separated.
CLIENT_URL=http://localhost:5173

# Cloudinary (Dashboard > API Keys). Without these, complaints still work but photo upload is disabled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: anyone who enters this code on the register page becomes an admin. Leave blank to disable.
ADMIN_SIGNUP_CODE=

# Used only by: npm run seed:admin
SEED_ADMIN_NAME=Campus Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123